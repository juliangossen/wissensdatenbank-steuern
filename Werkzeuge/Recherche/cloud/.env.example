# Vorlage: keine echten Zugangsdaten in diese Datei eintragen oder committen.
# Spätere Login-Konten werden getrennt kb_importer bzw. kb_mcp zugeordnet.
KB_IMPORT_DATABASE_URL=postgresql://IMPORT_LOGIN:PLACEHOLDER@DB_HOST:5432/postgres?sslmode=require
KB_MCP_DATABASE_URL=postgresql://READ_LOGIN:PLACEHOLDER@DB_HOST:5432/postgres?sslmode=require
KB_SUPABASE_URL=https://PROJECT_REF.supabase.co
KB_STORAGE_BUCKET=knowledge-assets
# Vom noch auszuwählenden OAuth-/Hostinganbieter:
KB_MCP_PUBLIC_URL=https://MCP_HOST/mcp
KB_OAUTH_ISSUER=https://AUTH_ISSUER/
KB_OAUTH_AUDIENCE=https://MCP_HOST/mcp
KB_OAUTH_REQUIRED_SCOPE=knowledge:read
# Zulassung wird später anhand stabiler Subject-IDs aus dem geprüften Token umgesetzt.
KB_ALLOWED_SUBJECTS=PLACEHOLDER
